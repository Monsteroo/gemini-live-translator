# Скопіюйте цей файл у .env і впишіть свої ключі.
# Gemini (дефолт) потребує лише GEMINI_API_KEY; гібрид — DASHSCOPE + OPENAI.
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # Qwen — напрямок співрозмовник→ви
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx      # OpenAI — напрямок ви→співрозмовник

# Palabra (тест голосу)
PALABRA_API_KEY=
